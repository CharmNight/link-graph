<idea-plugin>
    <id>com.charmnight.linkgraph</id>
    <name>Link Graph</name>
    <vendor>CharmNight</vendor>

    <description><![CDATA[
        Link Graph is an IntelliJ Platform plugin for exploring source relationships, project architecture, class diagrams, and review impact graphs inside a project.
        It provides a JCEF-based graph workbench with Mermaid import/export, source navigation, local fallback workflows, and optional remote LLM-assisted question answering, implementation suggestions, and code diff workflows.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="链路图"
                anchor="right"
                stripeTitle="链路图"
                factoryClass="com.charmnight.linkgraph.toolwindow.LinkGraphToolWindowFactory"/>
        <applicationConfigurable
                parentId="tools"
                id="com.charmnight.linkgraph.settings"
                displayName="链路图"
                instance="com.charmnight.linkgraph.settings.LinkGraphSettingsConfigurable"/>
        <projectService
                serviceInterface="com.charmnight.linkgraph.application.port.GraphEditorPresentationProvider"
                serviceImplementation="com.charmnight.linkgraph.ui.GraphEditorApplicationProjectionService"/>
        <projectService
                serviceInterface="com.charmnight.linkgraph.application.runtime.TaskRunner"
                serviceImplementation="com.charmnight.linkgraph.ui.runtime.IntelliJTaskRunnerAdapter"/>
        <projectService
                serviceInterface="com.charmnight.linkgraph.application.port.LlmApplicationServices"
                serviceImplementation="com.charmnight.linkgraph.llm.DefaultLlmApplicationServices"/>
        <postStartupActivity
                implementation="com.charmnight.linkgraph.toolwindow.debug.LinkGraphDebugStartupActivity"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <actions>
        <group
                id="com.charmnight.linkgraph.ToolsGroup"
                text="链路图"
                popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action
                    id="com.charmnight.linkgraph.OpenLinkGraphAction"
                    class="com.charmnight.linkgraph.actions.OpenLinkGraphAction"
                    text="查看当前方法完整链路">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
            <action
                    id="com.charmnight.linkgraph.AddCurrentMethodToGraphAction"
                    class="com.charmnight.linkgraph.actions.AddCurrentMethodToGraphAction"
                    text="添加当前方法到链路图">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
            <action
                    id="com.charmnight.linkgraph.OpenCurrentClassDiagramAction"
                    class="com.charmnight.linkgraph.actions.OpenCurrentClassDiagramAction"
                    text="打开当前类图">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
            <action
                    id="com.charmnight.linkgraph.ImportMermaidAction"
                    class="com.charmnight.linkgraph.actions.ImportMermaidAction"
                    text="导入 Mermaid"/>
            <action
                    id="com.charmnight.linkgraph.ExportMermaidAction"
                    class="com.charmnight.linkgraph.actions.ExportMermaidAction"
                    text="导出 Mermaid"/>
            <action
                    id="com.charmnight.linkgraph.ShowDiffModeAction"
                    class="com.charmnight.linkgraph.actions.ShowDiffModeAction"
                    text="查看差异"/>
            <action
                    id="com.charmnight.linkgraph.OpenLinkGraphSettingsAction"
                    class="com.charmnight.linkgraph.actions.OpenLinkGraphSettingsAction"
                    text="打开设置"/>
        </group>
    </actions>

    <!-- P3-1: 通过 linkGraph.* EP 暴露可扩展能力。
         LLM 第三方实现只描述请求构造 + 响应解析，实际 HTTP 请求仍由内置
         LlmGatewayClient 统一发送，SSRF / size guard 强制生效。 -->
    <extensionPoints>
        <extensionPoint
                name="linkGraph.llmGateway"
                interface="com.charmnight.linkgraph.llm.LlmGatewayContributor"
                dynamic="true"/>
        <extensionPoint
                name="linkGraph.projectionProvider"
                interface="com.charmnight.linkgraph.projection.ProjectionProvider"
                dynamic="true"/>
    </extensionPoints>
</idea-plugin>
